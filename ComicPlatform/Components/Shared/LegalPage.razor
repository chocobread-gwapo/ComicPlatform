<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

<article class="legal">
    <header>
        <h1>@Title</h1>
        <p class="updated">Last updated: @Updated</p>
    </header>

    @* DRAFT NOTICE: delete this one paragraph from here, and it disappears from both pages,
       once a lawyer has reviewed the text and the [bracketed] placeholders are filled in. *@
    <p class="draft">
        Draft: this page is a working draft and hasn't been legally reviewed yet.
    </p>

    @ChildContent
</article>

<style>
    .legal {
        font-family: 'Public Sans', sans-serif;
        color: var(--ink);
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
        line-height: 1.65;
    }

    .legal header {
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 3px solid var(--ink);
    }

    .legal h1 {
        font-family: 'Fraunces', serif;
        font-weight: 900;
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        margin: 0 0 0.25rem;
    }

    .legal .updated { margin: 0; color: var(--muted-text); font-size: 0.9rem; }

    .legal .draft {
        margin: 0 0 1.5rem;
        padding: 0.7rem 1rem;
        border: 1.5px solid var(--accent);
        font-size: 0.9rem;
    }

    .legal h2 {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.3rem;
        margin: 2rem 0 0.5rem;
    }

    .legal p { margin: 0 0 1rem; }
    .legal ul { margin: 0 0 1rem; padding-left: 1.25rem; }
    .legal li { margin-bottom: 0.35rem; }
    .legal a { color: var(--accent); font-weight: 600; }
</style>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Updated { get; set; } = string.Empty;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
