                    </svg>
                </span>
                <span class="theme-icon moon-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-moon-stars-fill" viewBox="0 0 16 16">
                        <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278"/>
                        <path d="M10.794 3.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387a1.73 1.73 0 0 0-1.097 1.097l-.387 1.162a.217.217 0 0 1-.412 0l-.387-1.162A1.73 1.73 0 0 0 9.31 6.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387a1.73 1.73 0 0 0 1.097-1.097zM13.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.16 1.16 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.16 1.16 0 0 0-.732-.732l-.774-.258a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732z"/>
                    </svg>
                </span>
                <span class="theme-knob"></span>
            </button>
        </NavMenu>
    </header>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>

    <footer class="site-footer">
        <a class="brand" href=""><Logo /> Catkoom</a>
        <nav aria-label="Footer">
            <a href="">Home</a>
            <a href="creator/my-series">Creator dashboard</a>
        </nav>
        <small>© @DateTime.UtcNow.Year Catkoom</small>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .theme-switch {
        position: relative;
        display: inline-flex;
        align-items: center;
        width: 4rem;
        height: 2.25rem;
        background: var(--paper);
        border: 1.5px solid var(--border-soft);
        border-radius: 999px;
        padding: 0.25rem;
        box-sizing: border-box;
        cursor: pointer;
    }

    .theme-icon {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        color: var(--muted-text);
        transition: color 0.3s ease;
    }

    html:not([data-theme="dark"]) .theme-switch .sun-icon {
        color: var(--ink);
    }

    html[data-theme="dark"] .theme-switch .moon-icon {
        color: var(--ink);
    }

    .theme-knob {
        position: absolute;
        top: 0.25rem;
        left: 0.25rem;
        width: 1.75rem;
        height: 1.75rem;
        background: var(--panel-bg);
        border-radius: 999px;
        z-index: 1;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html[data-theme="dark"] .theme-switch .theme-knob {
        transform: translateX(1.75rem);
    }
</style>

@code {
    private const string ChooseUsernamePath = "/account/chooseusername";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated != true)
        {
            return;
        }

        // Fast path: once the DisplayName claim exists (every account created
        // after the username feature, or anyone who's completed this gate once)
        // this returns immediately with no DB hit at all.
        if (!string.IsNullOrWhiteSpace(principal.FindFirstValue("DisplayName")))
        {
            return;
        }

        var currentPath = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (currentPath.Equals(ChooseUsernamePath, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);
        var displayName = await Db.Users
            .Where(u => u.Id == userId)
            .Select(u => u.DisplayName)
            .FirstOrDefaultAsync();

        if (string.IsNullOrWhiteSpace(displayName))
        {
            Nav.NavigateTo("/Account/ChooseUsername");
        }
    }
}
