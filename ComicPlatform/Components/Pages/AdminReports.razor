@page "/admin/reports"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using ComicPlatform.Data
@using ComicPlatform.Models
@inject ApplicationDbContext Db
@inject IWebHostEnvironment Env

<PageTitle>Reports - Admin</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="admin">
    <header class="admin-header">
        <h1>Reports</h1>
        <a class="back-link" href="/admin">&laquo; Series moderation</a>
    </header>

    <div class="pills">
        <button class="pill @(_tab == ReportStatus.Pending ? "on" : "")" @onclick="() => _tab = ReportStatus.Pending">
            Pending @if (_counts.TryGetValue(ReportStatus.Pending, out var p) && p > 0) { <text>(@p)</text> }
        </button>
        <button class="pill @(_tab == ReportStatus.Resolved ? "on" : "")" @onclick="() => _tab = ReportStatus.Resolved">Resolved</button>
        <button class="pill @(_tab == ReportStatus.Dismissed ? "on" : "")" @onclick="() => _tab = ReportStatus.Dismissed">Dismissed</button>
    </div>

    @if (_reports is null)
    {
        <p class="loading">Loading...</p>
    }
    else if (Filtered.Count == 0)
    {
        <p class="loading">Nothing here.</p>
    }
    else
    {
        <div class="report-list">
            @foreach (var report in Filtered)
            {
                <div class="report-row">
                    <div class="report-main">
                        <div class="report-top">
                            <span class="target-type">@TargetLabel(report.TargetType)</span>
                            <span class="reason">@Label(report.Reason)</span>
                            <span class="date">@report.CreatedAt.ToString("MMM d, yyyy")</span>
                        </div>
                        <p class="preview">
                            @if (report.TargetType == ReportTargetType.Creator && report.ReportedCreator is not null)
                            {
                                <a href="@CreatorUrl(report.ReportedCreator.Id)">@report.ReportedCreator.DisplayName</a>
                            }
                            else
                            {
                                @Preview(report)
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(report.Details))
                        {
                            <p class="details"><span class="details-label">Reason for reporting:</span>@report.Details</p>
                        }
                        <span class="reporter">Reported by <a href="@CreatorUrl(report.ReporterId)">@report.Reporter.DisplayName</a></span>
                    </div>

                    <div class="report-actions">
                        @if (TargetLink(report) is string link)
                        {
                            <a href="@link">View</a>
                        }

                        @if (report.Status == ReportStatus.Pending)
                        {
                            @if (report.TargetType == ReportTargetType.Creator)
                            {
                                @* A profile can't be "removed" like content. Ban from the Users
                                   screen first if that's the outcome, then resolve here. *@
                                <a href="/admin/users">Users</a>
                                <button type="button" class="dismiss-btn" @onclick="() => Dismiss(report)">Dismiss</button>
                                <button type="button" class="resolve-btn" @onclick="() => ResolveCreator(report)">Mark resolved</button>
                            }
                            else if (_confirmingRemoveId == report.Id)
                            {
                                <span class="confirm-delete">
                                    Remove content?
                                    <button type="button" class="confirm-yes" @onclick="() => ResolveAndRemove(report)">Yes</button>
                                    <button type="button" class="confirm-no" @onclick="() => _confirmingRemoveId = null">Cancel</button>
                                </span>
                            }
                            else
                            {
                                <button type="button" class="dismiss-btn" @onclick="() => Dismiss(report)">Dismiss</button>
                                <button type="button" class="remove-btn" @onclick="() => _confirmingRemoveId = report.Id">Remove content</button>
                            }
                        }
                        else
                        {
                            <span class="status-label status-@report.Status.ToString().ToLower()">@report.Status</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .admin {
        font-family: 'Public Sans', sans-serif;
        background: var(--paper);
        color: var(--ink);
        min-height: 100vh;
        padding: 2.5rem 2rem 4rem;
    }

    .admin-header {
        max-width: 1100px;
        margin: 0 auto 1.5rem;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        padding-bottom: 1.5rem;
        border-bottom: 3px solid var(--ink);
    }

    .admin-header h1 {
        font-family: 'Fraunces', serif;
        font-weight: 900;
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        margin: 0;
    }

    .back-link {
        color: var(--accent);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
    }

    .back-link:hover { text-decoration: underline; }

    .pills {
        max-width: 1100px;
        margin: 0 auto 1.5rem;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .pill {
        font: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.4rem 0.9rem;
        cursor: pointer;
        background: transparent;
        color: var(--ink);
        border: 1.5px solid var(--ink);
    }

    .pill:hover { background: var(--panel-bg); }
    .pill.on { background: var(--ink); color: var(--paper); }
    .pill:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .report-list {
        max-width: 1100px;
        margin: 0 auto;
    }

    .report-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        padding: 1.1rem 0.25rem;
        border-bottom: 1.5px solid var(--ink);
    }

    .report-row:first-child { border-top: 3px solid var(--ink); }

    .report-main { flex: 1; min-width: 260px; }

    .report-top {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
        margin-bottom: 0.3rem;
    }

    .target-type {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        border: 1.5px solid var(--ink);
        padding: 0.1rem 0.45rem;
    }

    .reason { font-weight: 600; font-size: 0.9rem; }
    .date { color: var(--muted-text); font-size: 0.85rem; }

    .preview {
        margin: 0.3rem 0;
        font-family: 'Fraunces', serif;
        font-size: 1rem;
        max-width: 60ch;
        overflow-wrap: break-word;
    }

    .preview a { color: var(--ink); text-decoration: underline; }
    .preview a:hover { color: var(--accent); }

    /* The reporter's own written explanation */
    .details {
        margin: 0.4rem 0 0.5rem;
        font-size: 0.9rem;
        max-width: 60ch;
        white-space: pre-wrap;
        overflow-wrap: break-word;
    }

    .details-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--muted-text);
        margin-bottom: 0.1rem;
    }

    .reporter { font-size: 0.85rem; color: var(--accent); }
    .reporter a { color: var(--accent); font-weight: 600; text-decoration: underline; }
    .reporter a:hover { color: var(--ink); }

    .report-actions {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    .report-actions > a {
        color: var(--ink);
        font-weight: 600;
        text-decoration: underline;
        font-size: 0.9rem;
    }

    .report-actions > a:hover { color: var(--accent); }

    .dismiss-btn, .remove-btn, .resolve-btn {
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.3rem 0.7rem;
        cursor: pointer;
        border: 1.5px solid var(--ink);
        background: transparent;
        color: var(--ink);
    }

    .dismiss-btn:hover, .resolve-btn:hover { background: var(--panel-bg); }

    .remove-btn { border-color: var(--danger); color: var(--danger); }
    .remove-btn:hover { background: var(--danger); color: var(--paper); }

    .confirm-delete {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--danger);
        font-weight: 600;
    }

    .confirm-yes, .confirm-no {
        border: 1.5px solid var(--ink);
        background: var(--panel-bg);
        color: var(--ink);
        padding: 0.2rem 0.55rem;
        font-size: 0.8rem;
        cursor: pointer;
    }

    .confirm-yes { border-color: var(--danger); color: var(--danger); }

    .status-label {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.2rem 0.6rem;
        border: 1.5px solid var(--ink);
        color: var(--muted-text);
    }

    .status-dismissed { opacity: 0.6; }

    .loading {
        max-width: 1100px;
        margin: 0 auto;
        font-family: 'Fraunces', serif;
        font-size: 1.1rem;
    }
</style>

@code {
    private List<Report>? _reports;
    private ReportStatus _tab = ReportStatus.Pending;
    private int? _confirmingRemoveId;
    private Dictionary<ReportStatus, int> _counts = new();

    private List<Report> Filtered => _reports?.Where(r => r.Status == _tab).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        _reports = await Db.Reports
            .Include(r => r.Reporter)
            .Include(r => r.Comment!).ThenInclude(c => c.Chapter)
            .Include(r => r.Series)
            .Include(r => r.CreatorPost)
            .Include(r => r.CreatorPostComment!).ThenInclude(c => c.CreatorPost)
            .Include(r => r.ReportedCreator)
            .OrderByDescending(r => r.CreatedAt)
            .ToListAsync();

        _counts = _reports
            .GroupBy(r => r.Status)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private static string Label(ReportReason r) => r switch
    {
        ReportReason.Spam => "Spam",
        ReportReason.HarassmentOrHate => "Harassment or hate speech",
        ReportReason.Spoilers => "Spoilers",
        ReportReason.Copyright => "Copyright / stolen content",
        ReportReason.Inappropriate => "Inappropriate content",
        _ => "Other"
    };

    private static string TargetLabel(ReportTargetType t) => t switch
    {
        ReportTargetType.Comment => "Comment",
        ReportTargetType.Series => "Series",
        ReportTargetType.CreatorPost => "Post",
        ReportTargetType.CreatorPostComment => "Post reply",
        ReportTargetType.Creator => "Creator",
        _ => t.ToString()
    };

    private static string Snippet(string text) => text.Length > 160 ? text[..160] + "…" : text;

    private static string Preview(Report r) => r.TargetType switch
    {
        ReportTargetType.Comment =>
            r.Comment is null ? "[comment already removed]" : Snippet(r.Comment.Content),
        ReportTargetType.CreatorPost =>
            r.CreatorPost is null ? "[post already removed]" : Snippet(r.CreatorPost.Content),
        ReportTargetType.CreatorPostComment =>
            r.CreatorPostComment is null ? "[reply already removed]" : Snippet(r.CreatorPostComment.Content),
        ReportTargetType.Creator =>
            r.ReportedCreator?.DisplayName ?? "[creator not found]",
        _ => r.Series?.Title ?? "[series already removed]"
    };

    // The /creator/{id} page loads any user, so this links readers' profiles too.
    private static string CreatorUrl(string userId) => $"/creator/{userId}";

    private static string? TargetLink(Report r)
    {
        if (r.TargetType == ReportTargetType.Comment && r.Comment is not null)
        {
            return $"/read/{r.Comment.Chapter.SeriesId}/{r.Comment.Chapter.Number}";
        }

        if (r.TargetType == ReportTargetType.Series && r.Series is not null)
        {
            return $"/series/{r.Series.Id}";
        }

        if (r.TargetType == ReportTargetType.CreatorPost && r.CreatorPost is not null)
        {
            return CreatorUrl(r.CreatorPost.CreatorId);
        }

        if (r.TargetType == ReportTargetType.CreatorPostComment && r.CreatorPostComment is not null)
        {
            return CreatorUrl(r.CreatorPostComment.CreatorPost.CreatorId);
        }

        if (r.TargetType == ReportTargetType.Creator && r.ReportedCreatorId is not null)
        {
            return CreatorUrl(r.ReportedCreatorId);
        }

        return null;
    }

    private async Task Dismiss(Report report)
    {
        report.Status = ReportStatus.Dismissed;
        await Db.SaveChangesAsync();
        await Reload();
    }

    private async Task ResolveCreator(Report report)
    {
        report.Status = ReportStatus.Resolved;

        // Same as removing content: close every other pending report on this creator too.
        if (report.ReportedCreatorId is string creatorId)
        {
            var siblings = await Db.Reports
                .Where(r => r.ReportedCreatorId == creatorId && r.Status == ReportStatus.Pending)
                .ToListAsync();
            foreach (var s in siblings)
            {
                s.Status = ReportStatus.Resolved;
            }
        }

        await Db.SaveChangesAsync();
        await Reload();
    }

    private async Task ResolveAndRemove(Report report)
    {
        switch (report.TargetType)
        {
            case ReportTargetType.Comment:
                await RemoveComment(report);
                break;
            case ReportTargetType.Series:
                await RemoveSeries(report);
                break;
            case ReportTargetType.CreatorPost:
                await RemoveCreatorPost(report);
                break;
            case ReportTargetType.CreatorPostComment:
                await RemoveCreatorPostComment(report);
                break;
        }

        _confirmingRemoveId = null;
        await Reload();
    }

    private async Task RemoveComment(Report report)
    {
        if (report.CommentId is int commentId)
        {
            var comment = await Db.Comments.FindAsync(commentId);
            if (comment is not null)
            {
                Db.Comments.Remove(comment);
            }

            var siblings = await Db.Reports
                .Where(r => r.CommentId == commentId && r.Status == ReportStatus.Pending)
                .ToListAsync();
            foreach (var s in siblings)
            {
                s.Status = ReportStatus.Resolved;
            }
        }
        else
        {
            report.Status = ReportStatus.Resolved;
        }

        await Db.SaveChangesAsync();
    }

    private async Task RemoveSeries(Report report)
    {
        // Filled in below with the series' image files, so they can be deleted after the database delete works.
        SeriesFiles? files = null;

        if (report.SeriesId is int seriesId)
        {
            var series = await Db.Series.FindAsync(seriesId);
            if (series is not null)
            {
                // Note which image files belong to this series BEFORE its rows are deleted.
                files = await SeriesCleanup.CollectAsync(Db, seriesId);

                var directReports = await Db.Reports
                    .Where(r => r.SeriesId == seriesId)
                    .ToListAsync();
                Db.Reports.RemoveRange(directReports);

                Db.Series.Remove(series);
            }
        }
        else
        {
            report.Status = ReportStatus.Resolved;
        }

        await Db.SaveChangesAsync();

        // Only now that the database delete has worked, delete the image files from disk.
        if (files is not null)
        {
            SeriesCleanup.Delete(Env, files);
        }
    }

    private async Task RemoveCreatorPost(Report report)
    {
        if (report.CreatorPostId is not int postId)
        {
            report.Status = ReportStatus.Resolved;
            await Db.SaveChangesAsync();
            return;
        }

        // Detaches and closes reports on the post and all its replies (Restrict links),
        // saving before the delete so the order is guaranteed.
        await ReportCleanup.DetachForCreatorPostAsync(Db, postId);

        var post = await Db.CreatorPosts.FindAsync(postId);
        if (post is not null)
        {
            Db.CreatorPosts.Remove(post);
            await Db.SaveChangesAsync();
        }
    }

    private async Task RemoveCreatorPostComment(Report report)
    {
        if (report.CreatorPostCommentId is not int commentId)
        {
            report.Status = ReportStatus.Resolved;
            await Db.SaveChangesAsync();
            return;
        }

        var target = await Db.CreatorPostComments.FindAsync(commentId);
        if (target is null)
        {
            report.Status = ReportStatus.Resolved;
            await Db.SaveChangesAsync();
            return;
        }

        // Replies can nest to any depth, and the parent link is Restrict, so the whole
        // subtree under this reply has to go with it.
        var all = await Db.CreatorPostComments
            .Where(c => c.CreatorPostId == target.CreatorPostId)
            .ToListAsync();

        var ids = new HashSet<int> { commentId };
        var grew = true;
        while (grew)
        {
            grew = false;
            foreach (var c in all)
            {
                if (c.ParentCommentId is int parentId && ids.Contains(parentId) && ids.Add(c.Id))
                {
                    grew = true;
                }
            }
        }

        await ReportCleanup.DetachForCreatorPostCommentsAsync(Db, ids.ToList());

        Db.CreatorPostComments.RemoveRange(all.Where(c => ids.Contains(c.Id)));
        await Db.SaveChangesAsync();
    }
}
