@page "/creator/my-series"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using ComicPlatform.Data
@using ComicPlatform.Models
@using System.Security.Claims
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Your Series</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="dashboard">
    <div class="page-head">
        <h1>Your Series</h1>
        <a class="btn solid" href="/creator/new-series">+ New Series</a>
    </div>

    @if (_series is null)
    {
        <p class="loading">Loading...</p>
    }
    else if (_series.Count == 0)
    {
        <div class="empty">
            <p>You haven't started a series yet.</p>
            <a href="/creator/new-series">Start your first one</a>
        </div>
    }
    else
    {
        <dl class="stats">
            <div><dt>Series</dt><dd>@_series.Count</dd></div>
            <div><dt>Views</dt><dd>@Compact(_series.Sum(s => s.Views))</dd></div>
            <div><dt>Likes</dt><dd>@Compact(_series.Sum(s => s.Likes))</dd></div>
            <div><dt>Followers</dt><dd>@Compact(_series.Sum(s => s.Followers))</dd></div>
        </dl>

        <div class="pills">
            <button class="pill @(!_sortByViews ? "on" : "")" @onclick="() => _sortByViews = false">Recently updated</button>
            <button class="pill @(_sortByViews ? "on" : "")" @onclick="() => _sortByViews = true">Most views</button>
        </div>

        <div class="series-list">
            @foreach (var s in Sorted)
            {
                <div class="row">
                    <a class="thumb" href="@($"/series/{s.Id}")">
                        @if (!string.IsNullOrEmpty(s.Cover))
                        {
                            <img src="@s.Cover" alt="" loading="lazy" />
                        }
                        else
                        {
                            <div class="thumb-placeholder">@s.Title</div>
                        }
                    </a>

                    <div class="info">
                        <div class="title-line">
                            <a class="title" href="@($"/series/{s.Id}")">@s.Title</a>
                            <span class="status status-@s.Status.ToString().ToLower()">@s.Status</span>
                            @if (!s.IsOriginalCreator)
                            {
                                <span class="tag">Co-author</span>
                            }
                        </div>
                        <div class="chapters">@ChapterSummary(s.Published, s.Drafts)</div>
                        <div class="stats-line">
                            <span>@Compact(s.Views) views</span>
                            <span class="likes">@Compact(s.Likes)</span>
                            <span>@Compact(s.Followers) followers</span>
                        </div>
                    </div>

                    <div class="actions">
                        <a class="btn" href="@($"/series/{s.Id}")">View</a>
                        <a class="btn" href="@($"/creator/series/{s.Id}/edit")">Edit</a>
                        <a class="btn solid" href="@($"/creator/series/{s.Id}/new-chapter")">+ Chapter</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .dashboard { font-family: 'Public Sans', sans-serif; color: var(--ink); max-width: 960px; margin: 0 auto; padding: 1.5rem 0 4rem; }

    .page-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 3px solid var(--ink); }
    .page-head h1 { font-family: 'Fraunces', serif; font-weight: 900; font-size: clamp(1.5rem, 4vw, 2rem); margin: 0; }

    .btn { display: inline-block; font: inherit; font-size: 0.85rem; font-weight: 600; text-decoration: none; cursor: pointer; padding: 0.4rem 0.9rem; border: 1.5px solid var(--ink); color: var(--ink); background: transparent; }
    .btn:hover { background: var(--panel-bg); }
    .btn.solid { background: var(--ink); color: var(--paper); }
    .btn.solid:hover { background: var(--accent); border-color: var(--accent); }
    .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .stats { display: flex; gap: 2rem; margin: 0 0 1.25rem; padding: 0.75rem 0; border-top: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); flex-wrap: wrap; }
    .stats div { display: flex; flex-direction: column; }
    .stats dt { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; color: var(--muted-text); }
    .stats dd { margin: 0; font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.25rem; }

    .pills { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; }
    .pill { font: inherit; font-size: 0.8rem; font-weight: 600; padding: 0.35rem 0.85rem; cursor: pointer; background: transparent; color: var(--ink); border: 1.5px solid var(--ink); }
    .pill:hover { background: var(--panel-bg); }
    .pill.on { background: var(--ink); color: var(--paper); }
    .pill:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .row { display: flex; align-items: center; gap: 1rem; padding: 1rem 0.1rem; border-bottom: 1.5px solid var(--border-soft); flex-wrap: wrap; }
    .row:first-of-type { border-top: 1.5px solid var(--border-soft); }

    .thumb { display: block; width: 64px; aspect-ratio: 3 / 4; flex-shrink: 0; border: 2px solid var(--ink); overflow: hidden; background: var(--panel-bg); }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .thumb-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0.3rem; font-family: 'Fraunces', serif; font-weight: 600; font-size: 0.7rem; line-height: 1.15;
        background: repeating-linear-gradient(135deg, var(--paper), var(--paper) 8px, var(--hatch) 8px, var(--hatch) 9px); }

    .info { flex: 1; min-width: 200px; display: flex; flex-direction: column; gap: 0.3rem; }
    .title-line { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .title { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.1rem; color: var(--ink); text-decoration: none; }
    .title:hover { text-decoration: underline; }
    .tag { font-size: 0.7rem; font-weight: 600; color: var(--muted-text); border: 1.5px solid var(--border-soft); padding: 0.1rem 0.45rem; }
    .chapters { font-size: 0.85rem; color: var(--muted-text); }
    .stats-line { display: flex; gap: 1rem; font-size: 0.8rem; color: var(--muted-text); flex-wrap: wrap; }
    .stats-line .likes::before { content: "\2665\00a0"; color: var(--accent); }

    .actions { display: flex; gap: 0.5rem; flex-shrink: 0; margin-left: auto; }

    .status { display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 0.1rem 0.5rem; border: 1.5px solid var(--ink); }
    .status-ongoing { background: var(--ink); color: var(--paper); }
    .status-hiatus { opacity: 0.55; }

    .empty, .loading { font-family: 'Fraunces', serif; font-size: 1.1rem; }
    .empty a { display: inline-block; margin-top: 0.75rem; color: var(--accent); font-weight: 600; text-decoration: underline; }

    @@media (max-width: 640px) {
        .row { position: relative; }
        .info { order: 1; }
        .actions { order: 2; margin-left: 0; width: 100%; }
    }
</style>

@code {
    private sealed record SeriesRow(int Id, string Title, string? Cover, SeriesStatus Status, bool IsOriginalCreator,
        int Published, int Drafts, int Views, int Likes, int Followers);

    private List<SeriesRow>? _series;
    private bool _sortByViews;

    private IEnumerable<SeriesRow> Sorted => _sortByViews
        ? _series!.OrderByDescending(s => s.Views)
        : _series!;

    private static string Compact(int n) => n >= 1_000_000 ? $"{n / 1_000_000.0:0.#}M"
        : n >= 1_000 ? $"{n / 1_000.0:0.#}K"
        : n.ToString();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var rows = await Db.Series
            .Where(s => s.CreatorId == userId || s.Authors.Any(a => a.UserId == userId))
            .OrderByDescending(s => s.UpdatedAt)
            .Select(s => new
            {
                s.Id,
                s.Title,
                s.CoverImageUrl,
                s.Status,
                s.CreatorId,
                Published = s.Chapters.Count(c => !c.IsDraft),
                Drafts = s.Chapters.Count(c => c.IsDraft),
                Views = s.Chapters.Sum(c => c.ViewCount),
                Likes = Db.Likes.Count(l => l.Chapter.SeriesId == s.Id),
                Followers = s.Followers.Count
            })
            .ToListAsync();

        _series = rows.Select(r => new SeriesRow(r.Id, r.Title, r.CoverImageUrl, r.Status, r.CreatorId == userId,
            r.Published, r.Drafts, r.Views, r.Likes, r.Followers)).ToList();
    }

    private static string ChapterSummary(int published, int drafts)
    {
        if (published == 0 && drafts == 0)
        {
            return "No chapters yet";
        }

        var parts = new List<string>();
        if (published > 0)
        {
            parts.Add($"{published} published");
        }
        if (drafts > 0)
        {
            parts.Add($"{drafts} draft{(drafts == 1 ? "" : "s")}");
        }

        return string.Join(", ", parts);
    }
}
