@page "/following"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using ComicPlatform.Data
@using ComicPlatform.Models
@using ComicPlatform.Components.Shared
@using System.Security.Claims
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider

<PageTitle>catkoom - Following</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

<AccountTabs />

<div class="browse">
    <div class="page-head">
        <h1>Following creators</h1>
    </div>

    @if (!_loaded)
    {
        <p class="loading">Loading...</p>
    }
    else if (_items.Count == 0)
    {
        <div class="empty">
            <p>You're not following any creators yet.</p>
            <a href="/">Browse series</a>
        </div>
    }
    else
    {
        <div class="list">
            @foreach (var item in _items)
            {
                <div class="row">
                    @if (!string.IsNullOrEmpty(item.AvatarUrl))
                    {
                        <img class="avatar" src="@item.AvatarUrl" alt="" />
                    }
                    else
                    {
                        <span class="avatar avatar-placeholder">@InitialOf(item.DisplayName)</span>
                    }
                    <span class="meta">
                        <span class="name">@item.DisplayName</span>
                        <span class="sub">Series @item.SeriesCount <span class="divider">|</span> Followers @item.FollowerCount</span>
                    </span>
                    <button class="unfollow" @onclick="() => Unfollow(item)">Unfollow</button>
                </div>
            }
        </div>
    }
</div>

<style>
    .browse { font-family: 'Public Sans', sans-serif; color: var(--ink); max-width: 1000px; margin: 0 auto; padding: 1.25rem 1rem 4rem; }

    .page-head { margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 3px solid var(--ink); }
    .page-head h1 { font-family: 'Fraunces', serif; font-weight: 900; font-size: clamp(1.5rem, 4vw, 2rem); margin: 0; }

    .list { display: flex; flex-direction: column; }
    .row { display: flex; align-items: center; gap: 1rem; padding: 0.85rem 0.1rem; border-bottom: 1.5px solid var(--border-soft); }
    .row:first-child { border-top: 1.5px solid var(--border-soft); }
    .row:hover { background: var(--panel-bg); }

    .avatar { width: 48px; height: 48px; flex-shrink: 0; object-fit: cover; border: 2px solid var(--ink); background: var(--paper); }
    .avatar-placeholder { display: flex; align-items: center; justify-content: center;
        font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.3rem; color: var(--ink);
        background: repeating-linear-gradient(135deg, var(--paper), var(--paper) 8px, var(--hatch) 8px, var(--hatch) 9px); }

    .meta { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
    .name { font-family: 'Fraunces', serif; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sub { font-size: 0.8rem; color: var(--muted-text); }
    .divider { margin: 0 0.3rem; opacity: 0.5; }

    .unfollow { flex-shrink: 0; font: inherit; font-size: 0.8rem; font-weight: 600; padding: 0.4rem 0.75rem; cursor: pointer;
        background: transparent; color: var(--muted-text); border: 1.5px solid var(--border-soft); }
    .unfollow:hover { background: var(--danger); border-color: var(--danger); color: var(--paper); }
    .unfollow:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .empty, .loading { font-family: 'Fraunces', serif; font-size: 1.1rem; }
    .empty a { display: inline-block; margin-top: 0.75rem; color: var(--accent); font-weight: 600; text-decoration: underline; }
</style>

@code {
    private List<FollowedCreatorItem> _items = new();
    private bool _loaded;
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        await using var db = await DbFactory.CreateDbContextAsync();

        var rows = await db.CreatorFollows
            .Where(cf => cf.UserId == _userId)
            .OrderByDescending(cf => cf.FollowedAt)
            .Select(cf => new
            {
                cf.Creator.Id,
                cf.Creator.DisplayName,
                cf.Creator.AvatarUrl,
                SeriesCount = db.Series.Count(s => s.CreatorId == cf.CreatorId),
                FollowerCount = db.CreatorFollows.Count(x => x.CreatorId == cf.CreatorId)
            })
            .ToListAsync();

        _items = rows.Select(r => new FollowedCreatorItem(r.Id, r.DisplayName, r.AvatarUrl, r.SeriesCount, r.FollowerCount)).ToList();
        _loaded = true;
    }

    private async Task Unfollow(FollowedCreatorItem item)
    {
        if (_userId is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var existing = await db.CreatorFollows.FindAsync(_userId, item.CreatorId);
        if (existing is not null)
        {
            db.CreatorFollows.Remove(existing);
            await db.SaveChangesAsync();
        }

        _items.Remove(item);
    }

    private static string InitialOf(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private sealed record FollowedCreatorItem(string CreatorId, string DisplayName, string? AvatarUrl, int SeriesCount, int FollowerCount);
}
