@page "/rankings"
@using Microsoft.EntityFrameworkCore
@using ComicPlatform.Data
@using ComicPlatform.Models
@inject ApplicationDbContext Db

<PageTitle>Rankings - Catkoom</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="browse">
    <div class="page-head">
        <h1>Rankings</h1>
        @if (_all.Count > 0)
        {
            <div class="pills">
                <button class="pill @(_tab == "trending" ? "on" : "")" @onclick='() => _tab = "trending"'>Trending</button>
                <button class="pill @(_tab == "popular" ? "on" : "")" @onclick='() => _tab = "popular"'>All-Time Popular</button>
            </div>
        }
    </div>

    @if (!_loaded)
    {
        <p class="loading">Loading...</p>
    }
    else if (!Ranked.Any())
    {
        <p class="empty">@(_tab == "trending" ? "Nothing trending in the last 30 days." : "Nothing published yet.")</p>
    }
    else
    {
        <div class="ranked-list">
            @{ var rank = 1; }
            @foreach (var s in Ranked)
            {
                <a class="rank-row" href="@($"/series/{s.Id}")">
                    <span class="rank-num @(rank <= 3 ? "top" : "")">@rank</span>
                    <div class="thumb">
                        @if (!string.IsNullOrEmpty(s.Cover))
                        {
                            <img src="@s.Cover" alt="" loading="lazy" />
                        }
                        else
                        {
                            <div class="thumb-placeholder">@s.Title</div>
                        }
                    </div>
                    <div class="info">
                        <span class="title">@s.Title</span>
                        <span class="sub">@(s.Genre ?? "Uncategorized") &middot; @Compact(s.Views) views</span>
                    </div>
                </a>
                rank++;
            }
        </div>
    }
</div>

<style>
    .browse { font-family: 'Public Sans', sans-serif; color: var(--ink); max-width: 800px; margin: 0 auto; padding: 1.5rem 0 4rem; }

    .page-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 3px solid var(--ink); }
    .page-head h1 { font-family: 'Fraunces', serif; font-weight: 900; font-size: clamp(1.5rem, 4vw, 2rem); margin: 0; }

    .pills { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .pill { font: inherit; font-size: 0.8rem; font-weight: 600; padding: 0.35rem 0.85rem; cursor: pointer; background: transparent; color: var(--ink); border: 1.5px solid var(--ink); }
    .pill:hover { background: var(--panel-bg); }
    .pill.on { background: var(--ink); color: var(--paper); }
    .pill:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .rank-row { display: flex; align-items: center; gap: 1rem; padding: 0.75rem 0.1rem; text-decoration: none; color: var(--ink); border-bottom: 1.5px solid var(--border-soft); }
    .rank-row:first-of-type { border-top: 1.5px solid var(--border-soft); }
    .rank-row:hover { background: var(--panel-bg); }
    .rank-row:focus-visible { outline: 3px solid var(--accent); outline-offset: -2px; }

    .rank-num { width: 2.75rem; flex-shrink: 0; text-align: center; font-family: 'Fraunces', serif; font-weight: 700; font-size: 1.5rem; color: var(--muted-text); }
    .rank-num.top { color: var(--accent); font-size: 2.1rem; }

    .thumb { width: 56px; aspect-ratio: 3 / 4; flex-shrink: 0; border: 2px solid var(--ink); overflow: hidden; background: var(--panel-bg); }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .thumb-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0.25rem; font-family: 'Fraunces', serif; font-weight: 600; font-size: 0.6rem; line-height: 1.1;
        background: repeating-linear-gradient(135deg, var(--paper), var(--paper) 8px, var(--hatch) 8px, var(--hatch) 9px); }

    .info { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
    .title { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.05rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sub { font-size: 0.8rem; color: var(--muted-text); }

    .empty, .loading { font-family: 'Fraunces', serif; font-size: 1.1rem; }
</style>

@code {
    private sealed record Card(int Id, string Title, string? Cover, string? Genre, int Views, DateTime? LastPublished);

    private List<Card> _all = new();
    private string _tab = "trending";
    private bool _loaded;

    private IEnumerable<Card> Ranked => (_tab == "trending"
            ? _all.Where(s => s.LastPublished > DateTime.UtcNow.AddDays(-30))
            : _all)
        .OrderByDescending(s => s.Views)
        .Take(50);

    private static string Compact(int n) => n >= 1_000_000 ? $"{n / 1_000_000.0:0.#}M"
        : n >= 1_000 ? $"{n / 1_000.0:0.#}K"
        : n.ToString();

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.UtcNow;

        var rows = await Db.Series
            .Where(s => s.Chapters.Any(c => !c.IsDraft && c.PublishedAt <= now))
            .Select(s => new
            {
                s.Id,
                s.Title,
                s.CoverImageUrl,
                Genre = s.Genres.Select(g => g.Name).FirstOrDefault(),
                Views = s.Chapters.Sum(c => c.ViewCount),
                Last = s.Chapters.Where(c => !c.IsDraft && c.PublishedAt <= now).Max(c => (DateTime?)c.PublishedAt)
            })
            .ToListAsync();

        _all = rows.Select(r => new Card(r.Id, r.Title, r.CoverImageUrl, r.Genre, r.Views, r.Last)).ToList();
        _loaded = true;
    }
}
